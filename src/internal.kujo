export dict_get_or := func(obj, key, fallback) {
    if type(obj) != "dict" { return fallback }
    if has_key(obj, key) { return obj[key] }
    return fallback
}

export failure := func(code, message, details) {
    return {"ok": false, "code": code, "message": message, "details": details}
}

export valid_non_empty_string := func(value, max_length) {
    if type(value) != "string" { return false }
    normalized := trim(value)
    return normalized != "" && len(normalized) <= max_length
}

export valid_optional_string := func(value, max_length) {
    if type(value) != "string" { return false }
    return len(trim(value)) <= max_length
}

export valid_non_negative_int := func(value) {
    return type(value) == "int" && value >= 0
}

export copy_array := func(value) {
    if type(value) != "array" { return [] }
    copied := []
    for item in value { copied = push(copied, item) }
    return copied
}

func canonicalize_json_impl(value) {
    if type(value) == "dict" {
        normalized := {}
        ordered_keys := sort(keys(value))
        for key in ordered_keys { normalized[key] := canonicalize_json_impl(value[key]) }
        return normalized
    }
    if type(value) == "array" {
        normalized_items := []
        for item in value { normalized_items = push(normalized_items, canonicalize_json_impl(item)) }
        return normalized_items
    }
    return value
}

export canonicalize_json := canonicalize_json_impl

export canonical_json := func(value) {
    return to_json(canonicalize_json_impl(value))
}

export json_digest := func(value) {
    return sha256(to_json(canonicalize_json_impl(value)))
}

func canonical_json_v2_impl(value) {
    if type(value) == "dict" {
        serialized := "{"
        ordered_keys := sort(keys(value))
        index := 0
        for key in ordered_keys {
            if index > 0 { serialized = serialized + "," }
            serialized = serialized + to_json(key) + ":" + canonical_json_v2_impl(value[key])
            index = index + 1
        }
        return serialized + "}"
    }
    if type(value) == "array" {
        serialized := "["
        index := 0
        for item in value {
            if index > 0 { serialized = serialized + "," }
            serialized = serialized + canonical_json_v2_impl(item)
            index = index + 1
        }
        return serialized + "]"
    }
    return to_json(value)
}

# Correct, cross-language canonical JSON. The unversioned helpers remain for
# v1 digest compatibility until consumers explicitly migrate.
export canonical_json_v2 := canonical_json_v2_impl

export json_digest_v2 := func(value) {
    return sha256(canonical_json_v2_impl(value))
}

func canonical_json_v2_supported_impl(value) {
    if type(value) == "int" { return value >= -9007199254740991 && value <= 9007199254740991 }
    if type(value) == "float" { return false }
    if type(value) == "dict" {
        for key in keys(value) { if canonical_json_v2_supported_impl(value[key]) == false { return false } }
        return true
    }
    if type(value) == "array" {
        for item in value { if canonical_json_v2_supported_impl(item) == false { return false } }
        return true
    }
    return type(value) == "string" || type(value) == "bool" || type(value) == "null"
}

export canonical_json_v2_supported := canonical_json_v2_supported_impl

export known_fields_only := func(obj, allowed, code, message) {
    if type(obj) != "dict" { return failure(code, message, {}) }
    for key in keys(obj) {
        known := false
        for allowed_key in allowed { if key == allowed_key { known = true } }
        if known == false { return failure(code, message, {"field": key}) }
    }
    return {"ok": true}
}
