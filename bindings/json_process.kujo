// Optional host-neutral binding factory. Configuration is operator code, never
// invocation input. Register the returned function with result_mode kujo.result/v1.
func failed(code) { return {"ok":false,"code":code,"message":"Bound process did not produce a complete valid result","details":{}} }
export func json_process_handler(configuration) {
    config := parse_json(to_json(configuration))
    assert(type(config) == "dict", "process binding configuration must be an object")
    allowed := ["argv","cwd","env","timeout_ms","max_output_bytes","input_mode"]
    for key in keys(config) { assert(contains(allowed,key),"unsupported process binding field") }
    assert(type(config["argv"]) == "array" && len(config["argv"]) > 0 && len(config["argv"]) <= 128,"bounded argv required")
    for argument in config["argv"] { assert(type(argument)=="string" && len(argument)<=8192,"argv must contain bounded strings") }
    assert(starts_with(config["argv"][0],"/"),"absolute executable required")
    assert(type(config["cwd"])=="string" && starts_with(config["cwd"],"/"),"absolute cwd required")
    assert(type(config["env"])=="dict","explicit environment required")
    for key in keys(config["env"]) { assert(type(config["env"][key])=="string","environment values must be strings") }
    assert(type(config["timeout_ms"])=="int" && config["timeout_ms"]>0 && config["timeout_ms"]<=120000,"bounded timeout required")
    assert(type(config["max_output_bytes"])=="int" && config["max_output_bytes"]>0 && config["max_output_bytes"]<=1048576,"bounded output required")
    assert(config["input_mode"]=="none" || config["input_mode"]=="json","unsupported process input mode")
    return func(input,context) {
        if config["input_mode"]=="none" && (type(input)!="dict" || len(keys(input))!=0) { return failed("ability_process_input_unsupported") }
        stdin := ""
        if config["input_mode"]=="json" { stdin=to_json(input) }
        if len(stdin)>1048576 { return failed("ability_process_input_too_large") }
        result := null
        try { result=spawn_process(config["argv"],{"cwd":config["cwd"],"env":config["env"],"inherit_env":false,"timeout_ms":config["timeout_ms"],"max_output_bytes":config["max_output_bytes"],"stdin":stdin}) } except e { return failed("ability_process_unavailable") }
        if result.timed_out { return failed("ability_process_timed_out") }
        if result.stdout_truncated || result.stderr_truncated { return failed("ability_process_output_limit") }
        if result.exitcode!=0 { return failed("ability_process_failed") }
        output := null
        try { output=parse_json(result.stdout) } except e { return failed("ability_process_invalid_json") }
        return {"ok":true,"result":output}
    }
}
