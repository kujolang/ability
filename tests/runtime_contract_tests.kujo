from src.contract import ability_definition_digest
from src.contracts import approval_binding_digest
from src.registry import create_ability_registry, register_ability_definition, register_ability_binding, register_ability_exposure, resolve_ability, list_ability_definitions
from src.runtime import execute_ability

func read_definition() {
    return {
        "schema": "kujo.ability/v1",
        "id": "kujo.docs.content.find",
        "version": "1.0.0",
        "description": "Find documentation records.",
        "input_schema": {"type": "object", "required": ["query"], "properties": {"query": {"type": "string"}}, "additionalProperties": false},
        "output_schema": {"type": "object", "required": ["count"], "properties": {"count": {"type": "integer"}}, "additionalProperties": false},
        "effects": [{"kind": "read", "resource": "kujo.docs.content"}],
        "idempotency": {"mode": "intrinsic"}
    }
}

func write_definition() {
    return {
        "schema": "kujo.ability/v1",
        "id": "kujo.cms.content.publish",
        "version": "1.0.0",
        "description": "Publish a content record.",
        "input_schema": {"type": "object", "required": ["id"], "properties": {"id": {"type": "integer"}}, "additionalProperties": false},
        "output_schema": {"type": "object", "required": ["published"], "properties": {"published": {"type": "boolean"}}, "additionalProperties": false},
        "effects": [{"kind": "write", "resource": "kujo.cms.content"}],
        "idempotency": {"mode": "keyed"}
    }
}

func read_handler(input, context) { return {"count": len(input["query"])} }
func invalid_handler(input, context) { return {"unexpected": true} }
func publish_handler(input, context) { return {"published": true} }
func envelope_failure_handler(input, context) { return {"ok": false, "status": 409, "code": "content_locked", "message": "Content is locked", "details": {"entry_id": 42}} }

func binding_for(definition, handler, handler_id) {
    return {"schema": "kujo.ability.binding/v1", "ability_id": definition["id"], "ability_version": definition["version"], "handler_id": handler_id, "handler_version": "1.0.0", "handler": handler, "timeout_ms": 30000, "metadata": {}}
}

func exposure_for(definition, surface) {
    return {"schema": "kujo.ability.exposure/v1", "ability_id": definition["id"], "ability_version": definition["version"], "surface": surface, "name": definition["id"], "enabled": true, "public": false, "metadata": {}}
}

func invocation_for(definition, input, key) {
    return {
        "schema": "kujo.ability.invocation/v1",
        "invocation_id": "invocation-test-1",
        "ability_id": definition["id"],
        "ability_version": definition["version"],
        "definition_digest": "",
        "input": input,
        "principal": {"type": "user", "id": "user-1", "tenant_id": "tenant-1", "claims": {}},
        "request_id": "request-test-1",
        "trace_id": "trace-test-1",
        "surface": "sdk",
        "idempotency_key": key,
        "approval": {},
        "metadata": {}
    }
}

func allow_policy(definition, invocation, exposure) { return {"schema": "kujo.ability.policy-decision/v1", "decision_id": "decision-allow", "outcome": "allow", "reason": "Authorized by the test policy.", "requirements": [], "policy_id": "kujo.test.policy", "policy_version": "1.0.0"} }
func deny_policy(definition, invocation, exposure) { return {"schema": "kujo.ability.policy-decision/v1", "decision_id": "decision-deny", "outcome": "deny", "reason": "Denied by the test policy.", "requirements": [], "policy_id": "kujo.test.policy", "policy_version": "1.0.0"} }
func approval_policy(definition, invocation, exposure) { return {"schema": "kujo.ability.policy-decision/v1", "decision_id": "decision-approval", "outcome": "approval_required", "reason": "Publishing requires approval.", "requirements": ["human"], "policy_id": "kujo.test.policy", "policy_version": "1.0.0"} }
func fixed_clock() { return 1000 }
func fixed_id(kind, invocation) { return kind + "-test-1" }
func audit_ok(phase, invocation, payload) { return {"ok": true, "written": true, "phase": phase, "event_id": "audit-" + phase} }
func consume_ok(approval, invocation) { return {"ok": true} }
func consume_fail(approval, invocation) { return {"ok": false} }
func begin_ok(key_digest, request_digest, invocation) { return {"state": "started"} }
func complete_ok(key_digest, request_digest, receipt) { return {"ok": true} }
func complete_fail(key_digest, request_digest, receipt) { return {"ok": false} }
func begin_in_progress(key_digest, request_digest, invocation) { return {"state": "in_progress"} }
func begin_conflict(key_digest, request_digest, invocation) { return {"state": "conflict"} }
func cancelled_true(invocation) { return true }
func audit_completion_fail(phase, invocation, payload) {
    if phase == "completed" { return {"ok": false} }
    return {"ok": true, "written": true, "phase": phase}
}

func services(policy) { return {"policy": policy, "clock_ms": fixed_clock, "id_factory": fixed_id, "audit": audit_ok, "audit_required": true} }

read := read_definition()
digest_one := ability_definition_digest(read)
read_reordered := {"version": read["version"], "schema": read["schema"], "output_schema": read["output_schema"], "input_schema": read["input_schema"], "idempotency": read["idempotency"], "id": read["id"], "effects": read["effects"], "description": read["description"]}
digest_two := ability_definition_digest(read_reordered)
assert(digest_one["digest"] == digest_two["digest"], "definition digest must be independent of object insertion order")

registry := create_ability_registry()
definition_result := register_ability_definition(registry, read)
assert(definition_result["ok"] && definition_result["registered"], "definition must register")
registry = definition_result["registry"]
assert(register_ability_definition(registry, read)["registered"] == false, "identical definition registration must be idempotent")
binding_result := register_ability_binding(registry, binding_for(read, read_handler, "kujo.docs.find.local"))
assert(binding_result["ok"], "binding must register")
registry = binding_result["registry"]
exposure_result := register_ability_exposure(registry, exposure_for(read, "sdk"))
assert(exposure_result["ok"], "exposure must register")
registry = exposure_result["registry"]
assert(resolve_ability(registry, read["id"], "1.0.1", "sdk")["code"] == "ability_definition_not_found", "resolution must require exact versions")
assert(len(list_ability_definitions(registry, "sdk")) == 1, "enabled surface catalog must contain the Ability")

successful := execute_ability(registry, invocation_for(read, {"query": "ability"}, ""), services(allow_policy))
assert(successful["ok"], "allowed Ability must execute")
assert(successful["receipt"]["status"] == "succeeded", "successful invocation must return a succeeded receipt")
assert(successful["receipt"]["result"]["count"] == 7, "receipt must contain validated handler output")
assert(successful["receipt"]["definition_digest"] == digest_one["digest"], "receipt must preserve the resolved definition digest")

denied := execute_ability(registry, invocation_for(read, {"query": "ability"}, ""), services(deny_policy))
assert(denied["receipt"]["status"] == "rejected" && denied["code"] == "ability_forbidden", "policy denial must return a rejected receipt")

invalid_registry := create_ability_registry()
invalid_step := register_ability_definition(invalid_registry, read); invalid_registry = invalid_step["registry"]
invalid_step = register_ability_binding(invalid_registry, binding_for(read, invalid_handler, "kujo.docs.find.invalid")); invalid_registry = invalid_step["registry"]
invalid_step = register_ability_exposure(invalid_registry, exposure_for(read, "sdk")); invalid_registry = invalid_step["registry"]
invalid_output := execute_ability(invalid_registry, invocation_for(read, {"query": "ability"}, ""), services(allow_policy))
assert(invalid_output["receipt"]["status"] == "failed" && invalid_output["code"] == "ability_output_invalid", "invalid handler output must fail closed")

envelope_registry := create_ability_registry()
envelope_step := register_ability_definition(envelope_registry, read); envelope_registry = envelope_step["registry"]
envelope_binding := binding_for(read, envelope_failure_handler, "kujo.docs.find.envelope")
envelope_binding["result_mode"] := "kujo.result/v1"
envelope_step = register_ability_binding(envelope_registry, envelope_binding); envelope_registry = envelope_step["registry"]
envelope_step = register_ability_exposure(envelope_registry, exposure_for(read, "sdk")); envelope_registry = envelope_step["registry"]
envelope_failure := execute_ability(envelope_registry, invocation_for(read, {"query": "ability"}, ""), services(allow_policy))
assert(envelope_failure["receipt"]["status"] == "failed" && envelope_failure["code"] == "content_locked", "structured handler failures must survive in the receipt")
assert(envelope_failure["receipt"]["error"]["details"]["http_status"] == 409, "structured handler status must be available to protocol adapters")

write := write_definition()
write_registry := create_ability_registry()
write_registration := register_ability_definition(write_registry, write)
write_registry = write_registration["registry"]
write_step := register_ability_binding(write_registry, binding_for(write, publish_handler, "kujo.cms.publish.local")); write_registry = write_step["registry"]
write_step = register_ability_exposure(write_registry, exposure_for(write, "sdk")); write_registry = write_step["registry"]
write_invocation := invocation_for(write, {"id": 42}, "publish-42")
write_invocation["definition_digest"] := write_registration["digest"]
approval_needed := execute_ability(write_registry, write_invocation, services(approval_policy))
assert(approval_needed["receipt"]["status"] == "approval_required", "policy must suspend an invocation that lacks approval")
approval_before_key := execute_ability(write_registry, invocation_for(write, {"id": 42}, ""), services(approval_policy))
assert(approval_before_key["receipt"]["status"] == "approval_required", "approval request discovery must precede keyed execution requirements")

approval := {"schema": "kujo.ability.approval/v1", "approval_id": "approval-test-1", "binding_digest": approval_binding_digest(write_invocation), "approved_by": {"type": "user", "id": "approver-1", "tenant_id": "tenant-1", "claims": {}}, "issued_at_ms": 900, "expires_at_ms": 1100, "nonce": "nonce-test-1", "evidence": {}}
write_invocation["approval"] := approval
approved_services := services(approval_policy)
approved_services["consume_approval"] := consume_ok
approved_services["begin_idempotency"] := begin_ok
approved_services["complete_idempotency"] := complete_ok
approved := execute_ability(write_registry, write_invocation, approved_services)
assert(approved["ok"] && approved["receipt"]["approval_id"] == "approval-test-1", "request-bound approval must execute once through the idempotent path")
assert(approved["receipt"]["idempotency"]["state"] == "completed", "keyed execution must commit idempotency state")

replay_services := services(approval_policy)
replay_services["consume_approval"] := consume_fail
replay_services["begin_idempotency"] := func(key_digest, request_digest, invocation) { return {"state": "replay", "receipt": approved["receipt"]} }
replay_services["complete_idempotency"] := complete_ok
replay := execute_ability(write_registry, write_invocation, replay_services)
assert(replay["ok"] && replay["replayed"] == true && replay["receipt"]["receipt_id"] == approved["receipt"]["receipt_id"], "a validated keyed replay must return before consuming approval again")

mismatched_receipt := parse_json(to_json(approved["receipt"]))
mismatched_principal := mismatched_receipt["principal"]
mismatched_principal["id"] := "user-2"
mismatched_receipt["principal"] := mismatched_principal
mismatch_services := services(approval_policy)
mismatch_services["consume_approval"] := consume_ok
mismatch_services["begin_idempotency"] := func(key_digest, request_digest, invocation) { return {"state": "replay", "receipt": mismatched_receipt} }
mismatch_services["complete_idempotency"] := complete_ok
mismatched_replay := execute_ability(write_registry, write_invocation, mismatch_services)
assert(mismatched_replay["code"] == "ability_idempotency_replay_mismatch", "replay receipts must match the invocation principal and surface")

missing_key_invocation := invocation_for(write, {"id": 43}, "")
missing_key := execute_ability(write_registry, missing_key_invocation, services(allow_policy))
assert(missing_key["code"] == "ability_idempotency_key_required", "keyed Ability must reject missing idempotency keys")
assert(missing_key["receipt"]["status"] == "rejected", "post-policy idempotency rejection must include a receipt")

replayed_services := services(approval_policy)
replayed_services["consume_approval"] := consume_fail
replayed_services["begin_idempotency"] := begin_ok
replayed_services["complete_idempotency"] := complete_ok
replayed := execute_ability(write_registry, write_invocation, replayed_services)
assert(replayed["code"] == "ability_approval_replayed" && replayed["receipt"]["status"] == "rejected", "approval replay must return a rejected receipt")

commit_failure_services := services(allow_policy)
commit_failure_services["begin_idempotency"] := begin_ok
commit_failure_services["complete_idempotency"] := complete_fail
commit_failure := execute_ability(write_registry, invocation_for(write, {"id": 44}, "publish-44"), commit_failure_services)
assert(commit_failure["code"] == "ability_idempotency_commit_failed", "idempotency commit failure must preserve its error code")
assert(commit_failure["receipt"]["status"] == "failed" && commit_failure["receipt"]["idempotency"]["state"] == "commit_failed", "idempotency commit failure must retain a reconciliable receipt")
assert(commit_failure["receipt"]["result"]["published"] == true && commit_failure["receipt"]["error"]["details"]["execution_status"] == "succeeded", "commit failure evidence must retain the executed result and prior outcome")

in_progress_services := services(allow_policy)
in_progress_services["begin_idempotency"] := begin_in_progress
in_progress_services["complete_idempotency"] := complete_ok
in_progress := execute_ability(write_registry, invocation_for(write, {"id": 45}, "publish-45"), in_progress_services)
assert(in_progress["code"] == "ability_invocation_in_progress" && in_progress["receipt"]["status"] == "rejected", "an in-progress keyed invocation must not execute again")

conflict_services := services(allow_policy)
conflict_services["begin_idempotency"] := begin_conflict
conflict_services["complete_idempotency"] := complete_ok
conflict := execute_ability(write_registry, invocation_for(write, {"id": 46}, "publish-46"), conflict_services)
assert(conflict["code"] == "ability_idempotency_conflict" && conflict["receipt"]["status"] == "rejected", "a reused key with different input must be rejected")

cancelled_services := services(allow_policy)
cancelled_services["begin_idempotency"] := begin_ok
cancelled_services["complete_idempotency"] := complete_ok
cancelled_services["cancelled"] := cancelled_true
cancelled := execute_ability(write_registry, invocation_for(write, {"id": 47}, "publish-47"), cancelled_services)
assert(cancelled["code"] == "ability_cancelled" && cancelled["receipt"]["status"] == "cancelled", "pre-handler cancellation must produce a terminal receipt")
assert(cancelled["receipt"]["idempotency"]["state"] == "completed", "keyed cancellation must commit a terminal idempotency receipt")

closed_audit_services := services(allow_policy)
closed_audit_services["audit"] := audit_completion_fail
closed_audit := execute_ability(registry, invocation_for(read, {"query": "audit"}, ""), closed_audit_services)
assert(closed_audit["code"] == "ability_audit_failed_after_execution" && closed_audit["receipt"]["status"] == "failed", "completion audit failure must fail closed by default")
assert(closed_audit["receipt"]["result"]["count"] == 5, "post-execution audit failure must retain the executed result for reconciliation")

open_audit_services := services(allow_policy)
open_audit_services["audit"] := audit_completion_fail
open_audit_services["audit_failure_mode"] := "open"
open_audit := execute_ability(registry, invocation_for(read, {"query": "audit"}, ""), open_audit_services)
assert(open_audit["ok"] && open_audit["receipt"]["audit"]["ok"] == false, "explicit audit fail-open mode must preserve failure evidence without changing the execution outcome")

print("ability runtime contract tests: all assertions passed")
