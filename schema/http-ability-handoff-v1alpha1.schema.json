{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http.ability-handoff/v1alpha1",
  "title": "Experimental local HTTP Ability evidence handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "ability_id",
    "ability_version",
    "ability_invocation_id",
    "dispatch_run_id",
    "dispatch_step_id",
    "dispatch_attempt_id",
    "dispatch_effect_id",
    "definition_digest",
    "transaction_sha256",
    "outcome",
    "receipt_id",
    "execution_result_ref",
    "receipt_ref",
    "assurance_ref",
    "client_request_id",
    "http_request_id",
    "method",
    "route_id",
    "operation_id"
  ],
  "properties": {
    "schema": {
      "const": "http.ability-handoff/v1alpha1"
    },
    "ability_id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "ability_version": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "ability_invocation_id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "dispatch_run_id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "dispatch_step_id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "dispatch_attempt_id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "dispatch_effect_id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "definition_digest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "transaction_sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "outcome": {
      "enum": [
        "receipt_succeeded",
        "application_error",
        "application_unavailable",
        "response_lost",
        "timeout"
      ]
    },
    "receipt_id": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "execution_result_ref": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "receipt_ref": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 71,
          "maxLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "assurance_ref": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 71,
          "maxLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "client_request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "http_request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "method": {
      "const": "POST"
    },
    "route_id": {
      "const": "publication_run"
    },
    "operation_id": {
      "const": "publication_create"
    }
  }
}
