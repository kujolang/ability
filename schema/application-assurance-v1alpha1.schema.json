{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Experimental application gateway profile (8 KiB transport bound)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "ability_id",
    "ability_version",
    "surface",
    "operation",
    "definition_digest",
    "principal_sha256",
    "tenant_sha256",
    "key_digest",
    "request_digest",
    "intent_sha256",
    "target_sha256",
    "transaction_sha256",
    "input_sha256"
  ],
  "properties": {
    "schema": {
      "const": "ability.application-assurance/v1alpha1"
    },
    "ability_id": {
      "const": "kujo.fixture.publication.create"
    },
    "ability_version": {
      "const": "1.0.0"
    },
    "surface": {
      "const": "sdk"
    },
    "operation": {
      "const": "create"
    },
    "definition_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "principal_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "tenant_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "key_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "request_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "intent_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "target_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "transaction_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
